# Medusa.js Headless Commerce Backend URL & Publishable API Key
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=your_medusa_publishable_key_here

# Cloudflare R2 S3-Compatible Object Storage Credentials
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"
R2_BUCKET_NAME="lms-videos"

# Production SMTP Email Notification Service
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="Sakil Hub <your_email@gmail.com>"
ADMIN_NOTIFICATION_EMAIL="admin@sakilhub.com"
